# Copy to `.env.local` for local dev, or set these as environment variables in Vercel.
# Both are OPTIONAL — the app runs fully without them.

# Enables the Claude copy layer. Without it, the advisor ships deterministic
# templated copy (meta.copySource = "engine"). With it, Claude re-voices two
# prose fields and copySource flips to "claude". Server-side only — never
# exposed to the storefront.
ANTHROPIC_API_KEY=

# Comma-separated CORS allowlist for the storefront(s) that call the API
# directly (Option B). Not needed if you use a Shopify App Proxy (Option A),
# which makes the call same-origin. Unset = reflect any origin (fine locally).
# ALLOWED_ORIGINS=https://your-store.myshopify.com,https://your-store.com
ALLOWED_ORIGINS=
